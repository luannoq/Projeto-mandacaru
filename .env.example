# Credenciais do Firebase (console.firebase.google.com → Configurações do projeto → Apps Web)
# Copie este arquivo para .env e preencha. NÃO commite o .env.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL base da API (legado — substituída pelos 2 microserviços abaixo)
EXPO_PUBLIC_API_URL=http://localhost:8080

# API Java do Victor — 2 microserviços (use a URL do ngrok ao testar no Expo Go)
EXPO_PUBLIC_API_CATALOGO_URL=http://localhost:8081
EXPO_PUBLIC_API_RECOMENDACAO_URL=http://localhost:8082

# Usa os mocks locais como fallback (true) ou as APIs reais (false)
EXPO_PUBLIC_USE_MOCKS=false
